{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CarrierLitigationDefenseIntake",
  "type": "object",
  "properties": {
    "case_style": {
      "type": "string",
      "description": "Plaintiff v. Carrier / Insured"
    },
    "court_jurisdiction": {
      "type": "string"
    },
    "date_served": {
      "type": "string",
      "format": "date"
    },
    "statutory_response_deadline": {
      "type": "string",
      "format": "date"
    },
    "policy_number": {
      "type": "string"
    },
    "reservation_of_rights_issued": {
      "type": "boolean"
    },
    "assigned_defense_counsel": {
      "type": "string"
    }
  },
  "required": [
    "case_style",
    "court_jurisdiction",
    "date_served",
    "statutory_response_deadline",
    "policy_number",
    "reservation_of_rights_issued"
  ],
  "additionalProperties": false
}
